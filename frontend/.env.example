# Clerk Authentication (Get your keys from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Backend API (Live Render URL)
NEXT_PUBLIC_BACKEND_URL=https://safespark.onrender.com

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key

# Speech Synthesis (Optional)
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key

# TinyFish Web Agent & Research Platform (Server-Side Only - Never expose to client)
TINYFISH_API_KEY=your_tinyfish_api_key

# Gnani AI Speech APIs (Vachana Speech STT & TTS across 10+ Indian Languages)
GNANI_API_KEY=vach_your_gnani_api_key

# SafeSpark Multilingual & Localized Routing
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
