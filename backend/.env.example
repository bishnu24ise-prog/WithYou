# SafeSpark Backend Environment Variables

# MongoDB Connection
MONGO_ENDPOINT=mongodb+srv://<username>:<password>@cluster0.mongodb.net/SheBuilds?retryWrites=true&w=majority

# AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_TOKEN=your_groq_api_token_here

# AWS Bedrock & S3 (Optional - for Bedrock Titan Image Generation)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=shebuilds-womentechmakers

# Twitter API (Optional - for posting emergency alerts)
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# CORS Allowed Origins (Comma-separated or * for wildcard)
ALLOWED_ORIGINS=*


# TinyFish Web Agent & Research Platform (Server-Side Only)
TINYFISH_API_KEY=your_tinyfish_api_key
